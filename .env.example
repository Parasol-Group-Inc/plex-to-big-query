# .env.example
# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.
#
#   cp .env.example .env
#
# ─────────────────────────────────────────────────────────────────────────────
# SECTION 1 — REQUIRED IN BOTH LOCAL AND BIGQUERY MODES
# ─────────────────────────────────────────────────────────────────────────────

# Plex ODBC credentials — two auth modes supported:
#   IAM token (preferred): set PLEX_ACCESS_TOKEN, leave user/password/company blank.
#   Username/password: set PLEX_ODBC_USER, PLEX_ODBC_PASSWORD, PLEX_COMPANY_CODE.
PLEX_ACCESS_TOKEN=
PLEX_ODBC_USER=
PLEX_ODBC_PASSWORD=
PLEX_COMPANY_CODE=

# Plex DSN — must match a [section] in config/odbc.ini
# PlexProduction (default) or PlexTest
PLEX_DSN=PlexProduction

# Backfill window in minutes — subtracts this from last_sync to catch
# rows that were written to Plex just before the previous run completed.
# Default 5 is safe for most deployments.
BACKFILL_MINUTES=5

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 2 — LOCAL MODE  (docker compose up)
# docker-compose.yml already sets OUTPUT_MODE=local and OUTPUT_DIR=/output.
# You only need to set BQ_TABLE here — it becomes the CSV filename prefix.
# ─────────────────────────────────────────────────────────────────────────────

# Name of the Plex view/report you are testing. Used as the CSV filename prefix.
# Example: production_orders → output/production_orders_20260519T020000Z.csv
BQ_TABLE=production_orders

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 3 — BIGQUERY MODE  (Cloud Run, or local bigquery run)
# These are not used in local mode but must be set for GCP deployment.
# ─────────────────────────────────────────────────────────────────────────────

# Your GCP project ID (not the display name)
GCP_PROJECT=

# BigQuery dataset name — must exist before the first run (Terraform creates it)
BQ_DATASET=plex_dataset

# Internal table that tracks incremental sync state
METADATA_TABLE=sync_metadata

# Secret Manager secret names — these are identifiers, not the actual values.
# Terraform creates these secrets; you add the real credential values separately.
SECRET_ODBC_USER=plex-odbc-user
SECRET_ODBC_PASSWORD=plex-odbc-password
SECRET_COMPANY_CODE=plex-company-code

# ─────────────────────────────────────────────────────────────────────────────
# SECTION 4 — EMAIL REPORTING  (bigquery mode only, optional)
# Leave SENDGRID_ENABLED=false to disable entirely.
# ─────────────────────────────────────────────────────────────────────────────

SENDGRID_ENABLED=false
SENDGRID_API_KEY=
REPORT_FROM_EMAIL=
REPORT_TO_EMAILS=
REPORT_SUBJECT=Plex to BigQuery ETL Report
REPORT_TEMPLATE=report.html
