driver/
.env
output/
terraform/terraform.tfvars
terraform/*.tfstate
terraform/*.tfstate.backup
terraform/.terraform/
terraform/.terraform.lock.hcl

# Python bytecode
__pycache__/
*.pyc

# Terraform numbered state backups (created by state migrations)
terraform/*.tfstate.*.backup
# Vendor driver packages and license (proprietary binaries + license serial — never commit)
zipfiles/

# Meeting audio — transcripts and summaries are committed, recordings are not.
# A recording of a conversation with named people does not belong in a repo
# that gets shared; the text next to it carries everything we act on.
meetings-reference/**/*.mp3
meetings-reference/**/*.m4a
meetings-reference/**/*.wav

# Plex's raw glossary export (~6.4 MB). The distilled result lives in
# docs/PLEX_GLOSSARY.md and IS committed; this is only the input.
# Re-export from Plex if you need to re-run scripts/distill_glossary.py.
catalog/Glossary-*.csv

# The historical Label Design export (~1.8 MB). It is a live customer list —
# real names, emails and order history — and the same reasoning that keeps the
# meeting audio out of a repo that gets shared applies to it.
#
# deploy/label_design_sync/test_logic.js uses it when present and skips the
# archive-dependent checks when it is not, naming this entry so nobody thinks
# the test is broken. To get it back:
#
#   gcloud storage cp "gs://voxdatalake-terraform-state/plex-to-big-query/backups/latest/assets__Copy of Design in Monday- NEW - historical.csv" "assets/Copy of Design in Monday- NEW - historical.csv"
#
# The MONDAY tab export IS committed — it is the 15-column header row with no
# data rows, and it is the contract SHEET_MAP encodes.
assets/Copy of Design in Monday- NEW - historical.csv
