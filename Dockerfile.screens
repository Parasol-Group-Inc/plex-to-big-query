# Plex live screens job (plex-live-screens, 2026-11-10).
#
# The ETL image (Plex ODBC driver, BigQuery, Secret Manager, SendGrid, main.py's
# email helpers) plus Playwright and headless Chromium, and the screen scripts.
# Kept separate so the 31 ETL jobs do not carry a ~500 MB browser.
# Built by deploy/cloudbuild.yaml right after the ETL image, FROM that same SHA:
#   docker build -f Dockerfile.screens --build-arg BASE=<etl image:sha> .
# Runbook: docs/PLEX_SCREEN_EXTRACTION.md, "Cloud job".
ARG BASE
FROM ${BASE}

RUN pip install --no-cache-dir playwright==1.64.1 && \
    python -m playwright install --with-deps chromium && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/screen_recon.py scripts/plex_live_screens.py scripts/plex_web_export.py scripts/load_plex_csv_dump.py scripts/
# The OS lock (plex_web.lock) and any dumps live here; nothing is kept between runs.
RUN mkdir -p /app/etl-manual

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "scripts/screen_recon.py"]
