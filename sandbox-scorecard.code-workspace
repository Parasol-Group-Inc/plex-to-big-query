// Scorecard Sandbox: the ScorecardSandbox dataset build and the fixes it finds.
// Opens ../ptbq-sandbox, the git worktree bound to `dev-sandbox`. Each project has its own
// folder so two sessions can never share a working tree (CONTRIBUTING.md).
{
	"folders": [
		{
			"name": "Scorecard Sandbox  [dev-sandbox]",
			"path": "../ptbq-sandbox"
		}
	],
	"settings": {
		"files.exclude": {
			"label-design": true,
			"label_design_service": true,
			"deploy/label_design_sync": true,
			"deploy/label_design_trigger": true,
			"meetings-reference/label-design": true,
			"deploy/manual_data_app": true
		},
		"search.exclude": {
			"label-design": true,
			"label_design_service": true,
			"deploy/label_design_sync": true,
			"deploy/label_design_trigger": true,
			"meetings-reference/label-design": true,
			"deploy/manual_data_app": true
		},
		"window.title": "Scorecard Sandbox [dev-sandbox] \u2014 ${activeEditorShort}",
		"workbench.colorCustomizations": {
			"titleBar.activeBackground": "#7a4a00",
			"titleBar.activeForeground": "#ffffff"
		},
		"git.branchProtection": [
			"main"
		],
		"git.branchProtectionPrompt": "alwaysPrompt"
	}
}
